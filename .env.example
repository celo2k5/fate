# FATE environment
# Where the SQLite ledger lives (swap DB layer for Postgres in production)
FATE_DB_PATH=./data/fate.db
# Keeper: autonomous destiny execution interval in ms (0 disables in-process keeper)
FATE_KEEPER_INTERVAL_MS=4000
# Network label shown in UI
FATE_NETWORK=simnet
# Protocol-governed parameters (basis points)
FATE_TRADE_FEE_BPS=100
FATE_DESTINY_SHARE_BPS=8000
# Admin console (/admin). Required before any deployment; dev default is 'fate-admin' with a console warning.
FATE_ADMIN_KEY=
FATE_SESSION_SECRET=
